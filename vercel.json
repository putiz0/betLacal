{
  "version": 2,
  "public": true,
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://uagwqerjcjjlnftytkqe.supabase.co/functions/v1/api-football/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
