# ============================================
# Bet Local - Configuracao de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# API-Football (opcional - 8 chaves separadas por virgula)
API_FOOTBALL_KEYS=chave1,chave2,chave3,chave4,chave5,chave6,chave7,chave8

# API-Football (alternativa - chave unica)
API_FOOTBALL_KEY=sua-chave-api-football

# Modo de jogo: "auto" | "demo" | "api"
GAME_MODE=auto
