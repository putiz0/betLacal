# ============================================
# Bet Local - Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# ATENÇÃO: .env nunca é commitado (veja .gitignore).

# ---------------- Frontend (local) ----------------
# O frontend lê a config de js/config.local.js (NÃO versionado).
# Copie js/config.template.js -> js/config.local.js e preencha:
#   - SUPABASE_URL
#   - SUPABASE_ANON_KEY (chave pública anon, NUNCA a service_role)
#   - backendUrl (Edge Function)
# Veja js/config.template.js.

# ---------------- Backend local (Python, deprecated) ----------------
# Usado apenas pelo backend FastAPI local (ver backend/README.md).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# API-Football para o backend local:
API_FOOTBALL_KEY=sua-chave-api-football

# ---------------- Edge Function (produção) ----------------
# NÃO defina as chaves da API-Football no código. Defina como Supabase secret:
#   supabase secrets set API_FOOTBALL_KEYS=chave1,chave2,...,chave8
# ou chave única:
#   supabase secrets set API_FOOTBALL_KEY=sua-chave
API_FOOTBALL_KEYS=chave1,chave2,chave3,chave4,chave5,chave6,chave7,chave8

# Modo de jogo do frontend: "auto" | "demo" | "api"
GAME_MODE=auto
